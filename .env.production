# ========================================
# CiteKit - Environment Variables Template
# ========================================
#
# Copy this file to .env and fill in your values:
#   cp .env.production .env
#   nano .env
#
# ========================================

# ========================================
# REQUIRED - API Keys
# ========================================

# Google Gemini API Key (for AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# ========================================
# REQUIRED - Database (Supabase)
# ========================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ========================================
# REQUIRED - Payments (Razorpay)
# ========================================

RAZORPAY_KEY_ID=rzp_live_xxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Payment amount in paise (42000 = ₹420)
PAYMENT_AMOUNT_PAISE=42000
PAYMENT_CURRENCY=INR

# ========================================
# REQUIRED - Security
# ========================================

# JWT Secret for token signing (generate with: openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key-generate-a-random-one

# Admin email (for admin panel access)
ADMIN_EMAIL=admin@yourdomain.com

# ========================================
# REQUIRED - CORS (Frontend URLs)
# ========================================

# Comma-separated list of allowed origins
CORS_ORIGINS=https://your-frontend.com,https://www.your-frontend.com

# ========================================
# OPTIONAL - Redis (defaults to local)
# ========================================

# Redis URL (provided by docker-compose, override for external Redis)
# REDIS_URL=redis://redis:6379/0

# ========================================
# OPTIONAL - Gemini Model
# ========================================

# Gemini model to use (default: gemini-2.0-flash-exp)
# GEMINI_MODEL=gemini-2.0-flash-exp

# ========================================
# OPTIONAL - Logging
# ========================================

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# ========================================
# OPTIONAL - Email Notifications (Mailgun)
# ========================================

# Get your API key from https://app.mailgun.com/app/account/security/api_keys
# MAILGUN_API_KEY=xxxxxxxx-xxxxxxxx-xxxxxxxx

# Your Mailgun domain (sandbox for testing, or your verified domain)
# MAILGUN_DOMAIN=sandbox123456.mailgun.org

# From email address
# EMAIL_FROM=CiteKit <noreply@yourdomain.com>

# For EU region, use: https://api.eu.mailgun.net/v3
# MAILGUN_API_BASE=https://api.mailgun.net/v3

# ========================================
# DO NOT CHANGE - Set by Docker
# ========================================

# These are set automatically by docker-compose
# PORT=8000
# OUTPUT_DIR=/app/output
