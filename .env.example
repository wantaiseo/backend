# ============================================
# GEO Compiler - Environment Variables
# Copy to .env and fill in your values
# ============================================

# Gemini API (Required)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# Supabase (Required)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here  # REQUIRED for Early Access / Admin tasks

# Redis (Required)
# Local: redis://localhost:6379/0
# Upstash (recommended for Cloud Run): rediss://default:xxx@xxx.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# Razorpay Payment Gateway (Required for payments)
# Get your API keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxx  # From Dashboard > Webhooks

# Pricing (Amount in smallest currency unit)
# INR: 42000 paise = ₹420 (~$5)
# USD: 500 cents = $5
PAYMENT_AMOUNT_PAISE=42000
PAYMENT_CURRENCY=INR

# Output Directory
OUTPUT_DIR=./output

# Frontend URL (Required for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# ============================================
# CORS - Allowed Origins (Production)
# ============================================
# Comma-separated list of allowed origins
# Example: https://myapp.com,https://www.myapp.com
ALLOWED_ORIGINS=

# ============================================
# Cloud Run Deployment (Auto-detected)
# ============================================
# These are automatically set by Cloud Run:
# K_SERVICE=geo-compiler-api
# K_REVISION=geo-compiler-api-00001-xxx
# PORT=8080

# Server Settings (Optional - for local dev)
# HOST=0.0.0.0
# PORT=8000

# Rate Limiting (Optional)
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_PER_HOUR=1000

